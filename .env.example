# Copy this file to .env in the repo root and adjust as needed:
#   cp .env.example .env
#
# This single .env is read by both docker-compose (for the Postgres
# container) and the FastAPI backend (see backend/app/core/config.py).

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=f1user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=f1db
POSTGRES_PORT=5432

# --- Backend (FastAPI / SQLAlchemy) ---
# Must match the Postgres values above.
DATABASE_URL=postgresql+psycopg2://f1user:changeme@localhost:5432/f1db

# --- Jolpica F1 API (Ergast successor) ---
# https://api.jolpi.ca/ergast/f1 - free, volunteer-run, 200 req/hour limit.
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
JOLPICA_CACHE_TTL_SECONDS=3600

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Future integrations (not used yet) ---
# Reserved for the Sportradar F1 API module (app/services/sportradar) once
# API access is set up.
SPORTRADAR_API_KEY=
# Reserved for a general news API once one is chosen for the news section
# (app/routers/news.py currently returns static placeholder data).
NEWS_API_KEY=

# --- Frontend (Next.js) ---
# Next.js only reads env files from within frontend/, so also copy this
# value into frontend/.env.local (see frontend/.env.local.example).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
