# Copy this file to .env in the repo root and adjust as needed:
#   cp .env.example .env
#
# This single .env is read by both docker-compose (for the Postgres
# container) and the FastAPI backend (see backend/app/core/config.py).
# The Flutter app does not read it - its backend URL is resolved in code
# (see mobile_app/lib/services/api_client.dart).
#
# Nothing here is secret: the Postgres credentials are for a throwaway
# local container, and every external data source the app uses is
# key-free. The two API-key slots at the bottom are reserved for optional
# future integrations and can stay empty.

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=f1user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=f1db
POSTGRES_PORT=5432

# --- Backend (FastAPI / SQLAlchemy) ---
# Must match the Postgres values above.
DATABASE_URL=postgresql+psycopg2://f1user:changeme@localhost:5432/f1db

# --- Jolpica F1 API (Ergast successor) ---
# https://api.jolpi.ca/ergast/f1 - free, volunteer-run, 200 req/hour limit.
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
JOLPICA_CACHE_TTL_SECONDS=3600

# --- News (free public RSS feed - no API key needed) ---
NEWS_FEED_URL=https://www.motorsport.com/rss/f1/news/
NEWS_CACHE_TTL_SECONDS=300

# --- CORS ---
# Only needed if you point a browser-based client at the API; the Flutter
# desktop/mobile app doesn't require it.
CORS_ORIGINS=http://localhost:3000

# --- Optional future integrations (unused - safe to leave empty) ---
# Reserved for the Sportradar F1 API module (backend/app/services/sportradar),
# which is a deliberate stub - the app runs fine without this.
SPORTRADAR_API_KEY=
# Reserved in case you swap the RSS news feed for a keyed news provider.
NEWS_API_KEY=
